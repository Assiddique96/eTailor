// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  SHOP_ADMIN
  EMPLOYEE
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_FITTING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum MessageChannel {
  APP
  EMAIL
  WHATSAPP
  SMS
}

model Shop {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  phone         String?
  email         String?
  address       String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  roles         Role[]
  customers     Customer[]
  jobs          Job[]
  invoices      Invoice[]
  payments      Payment[]
  messages      CustomerMessage[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id               String        @id @default(cuid())
  shopId           String?
  fullName         String
  email            String        @unique
  passwordHash     String
  platformRole     PlatformRole  @default(EMPLOYEE)
  isActive         Boolean       @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shop             Shop?         @relation(fields: [shopId], references: [id], onDelete: SetNull)
  userRoles        UserRole[]
  jobsCreated      Job[]         @relation("JobsCreatedBy")
  jobsAssigned     Job[]         @relation("JobsAssignedTo")
  invoicesCreated  Invoice[]     @relation("InvoicesCreatedBy")
  paymentsRecorded Payment[]     @relation("PaymentsRecordedBy")
  auditLogs        AuditLog[]
}

model Role {
  id          String       @id @default(cuid())
  shopId      String
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([shopId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Customer {
  id               String            @id @default(cuid())
  shopId           String
  firstName        String
  lastName         String
  phone            String?
  email            String?
  gender           String?
  preferredFit     String?
  preferredStyle   String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  measurements     MeasurementRecord[]
  jobs             Job[]
  invoices         Invoice[]
  messages         CustomerMessage[]
  orderHistories   OrderHistory[]

  @@index([shopId, firstName, lastName])
  @@index([phone])
}

model MeasurementRecord {
  id            String   @id @default(cuid())
  customerId    String
  chestCm       Decimal? @db.Decimal(8, 2)
  waistCm       Decimal? @db.Decimal(8, 2)
  hipCm         Decimal? @db.Decimal(8, 2)
  shoulderCm    Decimal? @db.Decimal(8, 2)
  sleeveCm      Decimal? @db.Decimal(8, 2)
  neckCm        Decimal? @db.Decimal(8, 2)
  inseamCm      Decimal? @db.Decimal(8, 2)
  outseamCm     Decimal? @db.Decimal(8, 2)
  extraJson     Json?
  recordedAt    DateTime @default(now())
  recordedBy    String?
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, recordedAt])
}

model OrderHistory {
  id          String   @id @default(cuid())
  customerId  String
  description String
  amount      Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Job {
  id               String        @id @default(cuid())
  shopId           String
  customerId       String
  title            String
  description      String?
  status           JobStatus     @default(PENDING)
  priority         Int           @default(3)
  dueDate          DateTime
  reminderSentAt   DateTime?
  createdById      String
  assignedToId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy        User          @relation("JobsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo       User?         @relation("JobsAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  invoice          Invoice?

  @@index([shopId, status, dueDate])
}

model Invoice {
  id            String        @id @default(cuid())
  shopId        String
  customerId    String
  jobId         String?       @unique
  invoiceNumber String
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy     User          @relation("InvoicesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@unique([shopId, invoiceNumber])
}

model Payment {
  id           String        @id @default(cuid())
  shopId       String
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       String
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  createdAt    DateTime      @default(now())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User          @relation("PaymentsRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
}

model CustomerMessage {
  id          String         @id @default(cuid())
  shopId      String
  customerId  String
  channel     MessageChannel @default(APP)
  subject     String?
  message     String
  sentBy      String?
  sentAt      DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, sentAt])
}

model Notification {
  id          String   @id @default(cuid())
  shopId      String
  title       String
  body        String
  targetDate  DateTime?
  isSent      Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
}
