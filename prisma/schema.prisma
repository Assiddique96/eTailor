// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  SHOP_ADMIN
  EMPLOYEE
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_FITTING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum MessageChannel {
  APP
  EMAIL
  WHATSAPP
  SMS
}


enum Gender {
  MALE
  FEMALE
  OTHER
}


enum StyleSelectionMode {
  CATALOG
  UPLOAD
  IMPRESS_ME
}

model Shop {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  phone         String?
  email         String?
  address       String?
  logoUrl        String?
  currency       String   @default("NGN")
  bankDetails    String?
  paymentTerms   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  roles         Role[]
  customers     Customer[]
  jobs          Job[]
  invoices      Invoice[]
  payments      Payment[]
  messages      CustomerMessage[]
  notifications Notification[]
  auditLogs     AuditLog[]
  measurementLinks MeasurementLink[]
  catalogCategories CatalogCategory[]
  catalogItems      CatalogItem[]
}

model User {
  id               String        @id @default(cuid())
  shopId           String?
  fullName         String
  email            String        @unique
  passwordHash     String
  platformRole     PlatformRole  @default(EMPLOYEE)
  isActive         Boolean       @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shop             Shop?         @relation(fields: [shopId], references: [id], onDelete: SetNull)
  userRoles        UserRole[]
  jobsCreated      Job[]         @relation("JobsCreatedBy")
  jobsAssigned     Job[]         @relation("JobsAssignedTo")
  invoicesCreated  Invoice[]     @relation("InvoicesCreatedBy")
  paymentsRecorded Payment[]     @relation("PaymentsRecordedBy")
  jobComments      JobComment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
}

model Role {
  id          String       @id @default(cuid())
  shopId      String
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([shopId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Customer {
  id               String            @id @default(cuid())
  shopId           String
  firstName        String
  lastName         String
  phone            String?
  email            String?
  gender           Gender?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  measurements     MeasurementRecord[]
  jobs             Job[]
  invoices         Invoice[]
  messages         CustomerMessage[]
  orderHistories   OrderHistory[]
  measurementLinks MeasurementLink[]
  styleProfile     CustomerStyleProfile?
  catalogCategories CatalogCategory[]
  catalogItems      CatalogItem[]

  @@index([shopId, firstName, lastName])
  @@index([phone])
}

model MeasurementRecord {
  id            String   @id @default(cuid())
  customerId    String
  chestCm       Decimal? @db.Decimal(8, 2)
  waistCm       Decimal? @db.Decimal(8, 2)
  hipCm         Decimal? @db.Decimal(8, 2)
  shoulderCm    Decimal? @db.Decimal(8, 2)
  sleeveCm      Decimal? @db.Decimal(8, 2)
  neckCm        Decimal? @db.Decimal(8, 2)
  inseamCm      Decimal? @db.Decimal(8, 2)
  outseamCm     Decimal? @db.Decimal(8, 2)
  extraJson     Json?
  recordedAt    DateTime @default(now())
  recordedBy    String?
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, recordedAt])
}

model OrderHistory {
  id          String   @id @default(cuid())
  customerId  String
  description String
  amount      Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Job {
  id               String        @id @default(cuid())
  shopId           String
  customerId       String
  title            String
  description      String?
  status           JobStatus     @default(PENDING)
  priority         Int           @default(3)
  dueDate          DateTime
  reminderSentAt   DateTime?
  depositAmount    Decimal?  @db.Decimal(10, 2)
  depositPaidAt    DateTime?
  createdById      String
  assignedToId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy        User          @relation("JobsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo       User?         @relation("JobsAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  invoice          Invoice?
  materials        JobMaterial[]
  comments         JobComment[]
  trackingCode String   @unique @default("")

  @@index([shopId, status, dueDate])
}



model JobComment {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  body      String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model JobMaterial {
  id            String  @id @default(cuid())
  jobId         String
  name          String
  colour        String?
  quantityMetres Decimal? @db.Decimal(8, 2)
  unitCost      Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2)
  supplier      String?
  notes         String?
  createdAt     DateTime @default(now())
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Invoice {
  id            String        @id @default(cuid())
  shopId        String
  customerId    String
  jobId         String?       @unique
  invoiceNumber String
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy     User          @relation("InvoicesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments      Payment[]
  lines         InvoiceLine[]

  @@unique([shopId, invoiceNumber])
}


model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  shopId       String
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       String
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  createdAt    DateTime      @default(now())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User          @relation("PaymentsRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
}

model CustomerMessage {
  id          String         @id @default(cuid())
  shopId      String
  customerId  String
  channel     MessageChannel @default(APP)
  subject     String?
  message     String
  sentBy      String?
  sentAt      DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, sentAt])
}

model Notification {
  id        String   @id @default(cuid())
  shopId    String
  userId    String?
  type      String   @default("INFO")
  title     String
  body      String
  entityId  String?
  entityType String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, isRead, createdAt])
  @@index([userId, isRead])
}


model MeasurementLink {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  customerId  String
  shopId      String
  gender      Gender
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([customerId])
}


model CatalogCategory {
  id          String        @id @default(cuid())
  shopId      String
  name        String
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items       CatalogItem[]
  customers   Customer[]

  @@unique([shopId, name])
  @@index([shopId, sortOrder])
}

model CatalogItem {
  id          String          @id @default(cuid())
  shopId      String
  categoryId  String
  name        String
  description String?
  imageUrl    String
  imagePath   String          // ImageKit file path for deletion
  tags        String[]
  gender      Gender[]
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  selections  CustomerStyleProfile[]
  customers   Customer[]
  @@index([shopId, categoryId])
  @@index([categoryId, sortOrder])
}

model CustomerStyleProfile {
  id              String              @id @default(cuid())
  customerId      String              @unique
  selectionMode   StyleSelectionMode?
  catalogItemId   String?             // set when mode = CATALOG
  uploadedImageUrl String?            // set when mode = UPLOAD
  uploadedImagePath String?           // ImageKit path for deletion
  notes           String?
  updatedAt       DateTime            @updatedAt
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  catalogItem     CatalogItem?        @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}